{
  "name": "etnpilot",
  "version": "0.1.0",
  "description": "A provider-neutral, GitLab-first agent harness with proof-carrying execution and local CodeGraph integration.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.js",
    "./plugin": "./src/plugins/sdk.js",
    "./plugins/vault": "./src/plugins/vault.js"
  },
  "bin": {
    "etnpilot": "bin/etnpilot.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.mjs && npm run lint && npm run typecheck && node --test test/*.test.js",
    "etnpilot": "node bin/etnpilot.js",
    "eval": "node bin/etnpilot.js eval",
    "smoke:gitlab": "node scripts/gitlab-smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "test:ui": "node --test test-ui/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@github/copilot-sdk": ">=1.0.14"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
